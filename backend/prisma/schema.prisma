generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gebruiker {
  id          String @id @default(cuid())
  naam        String
  emailadres  String @unique
  wachtwoord  String

  @@map("Gebruiker")
}

model Rapport {
  id                    Int                       @id @default(autoincrement())
  titel                 String
  datums                Json
  meldingen             Melding[]
  grafiekBeschrijving   GrafiekBeschrijving[]
  trendSamenvatting     RapportTrendSamenvatting?
  aangemaaktOp          DateTime                  @default(now())
  status                RapportStatus

  @@index([aangemaaktOp])
  @@map("Rapport")
}

enum RapportStatus {
  in_afwachting
  controle_nodig
  voltooid
  mislukt

  @@map("RapportStatusTypes")
}

model GrafiekBeschrijving {
  id                Int      @id @default(autoincrement())
  grafiekType       String
  beschrijving      String
  trendSoort        String?
  ernst             String?
  mogelijkeActies   Json?
  redenVoorWijziging String?
  rapportId         Int?
  rapport            Rapport? @relation(fields: [rapportId], references: [id])

  @@unique([rapportId, grafiekType])
  @@map("GrafiekBeschrijving")
}

model RapportTrendSamenvatting {
  id                 Int      @id @default(autoincrement())
  samenvatting       String
  hoogtepunten       Json?
  risico              Json?
  aanbevolenActies   Json?
  rapportId          Int?     @unique
  rapport            Rapport? @relation(fields: [rapportId], references: [id])

  @@map("RapportTrendSamenvatting")
}

model Melding {
  id                    Int      @id @default(autoincrement())
  topdeskId             String   @unique
  categorie             String
  subcategorie          String?
  systemen              Json     @default("[]")
  probleemtypes         Json     @default("[]")
  korteBeschrijvingAI   String?
  melderLocatie         String?
  melderAfdeling        String?
  melderRol             String?
  behandelaarNaam       String?
  behandelaarGroep      String?
  gesloten              Boolean
  geslotenOp            DateTime?
  afgerond              Boolean
  afgerondOp            DateTime?
  gereageerd            Boolean
  gereageerdOp          DateTime?
  aanmaakDatum          DateTime
  oproepDatum           DateTime?
  status                String?
  invoertype            String
  impact                String?
  urgentie              String?
  prioriteit            String?
  korteBeschrijving     String?
  laatsteBijwerking     DateTime?
  laatstBijgewerktDoor  String?
  rapportId             Int?
  rapport               Rapport? @relation(fields: [rapportId], references: [id])

  @@index([categorie])
  @@index([subcategorie])
  @@index([aanmaakDatum])
  @@index([gesloten])
  @@index([afgerond])
  @@index([status])
  @@index([invoertype])
  @@index([prioriteit])
  @@index([melderAfdeling])
  @@map("Melding")
}
